# OpenAI-compatible AI endpoint used for question generation and scoring.
DEEPSEEK_BASE_URL="http://127.0.0.1:9655/v1"
DEEPSEEK_MODEL="deepseek-reasoner"

# Set the provider key when the endpoint requires authentication.
# DEEPSEEK_API_KEY takes precedence over AI_KEY.
DEEPSEEK_API_KEY=""
AI_KEY=""

PORT=8000
CORS_ORIGIN="*"
